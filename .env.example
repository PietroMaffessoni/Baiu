# Copie para .env.local e preencha com os dados do projeto no Supabase.
# A chave é a pública (publishable). Nunca coloque a service_role/secret aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Só para testes na web: usa um servidor de contas falso (código 246810).
# EXPO_PUBLIC_AUTH_FAKE=1
