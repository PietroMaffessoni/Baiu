# Copie para .env.local e preencha com os dados do projeto no Supabase.
# A chave é a pública (publishable). Nunca coloque a service_role/secret aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Assinaturas (RevenueCat): chaves públicas do SDK, uma por loja. Sem elas, o app fica liberado.
# A chave secreta (sk_...) nunca vem para cá: ela fica só nos Secrets do Supabase.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Só para testes na web: usa um servidor de contas falso (código 246810),
# um banco de teste e uma loja de teste para a assinatura.
# EXPO_PUBLIC_AUTH_FAKE=1
