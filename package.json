  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:sql": "node scripts/test-contas-sql.mjs && node scripts/test-assistente-sql.mjs && node scripts/test-bancos-sql.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-baiu-chat.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-bank.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-subscription.mjs",
